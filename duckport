${BOLD}数据操作：${NC}
  duckport ${CYAN}loadhist${NC} <实例名>              补历史数据（必须指定实例）
  duckport ${CYAN}retention${NC} status               保留策略与最近一次执行结果
  duckport ${CYAN}retention${NC} set <表> <天数>       设置保留天数（--archive-dir DIR 先归档再删）
  duckport ${CYAN}retention${NC} disable <表>          停用某张表的策略
  duckport ${CYAN}retention${NC} dry-run|run [表]      立即执行（dry-run 只统计不删除）
  duckport ${CYAN}retention${NC} log [表]              执行日志
  duckport ${CYAN}doctor${NC} [--deep] [--json]         对照当前版本检查库的状态（只读）

${BOLD}维护：${NC}
  duckport ${CYAN}upgrade${NC} [--proxy URL] [--to TAG] 升级：服务端 → 插件 → 数据对齐，可重复执行
  duckport ${CYAN}upgrade${NC} --plan                 三个阶段的计划（只读）
  duckport ${CYAN}upgrade${NC} --data [--yes]         只做数据对齐：在线修正，或停写窗口（先备份）+ 复检
                                       （--no-backup 不备份；磁盘或内存不够备份时会询问；
                                        损坏/重复的行需人工确认，--delete-bad-rows 直接确认）
                                       有重建时继续：校验 → 删旧表 → 整库压缩 → 换文件 → 删备份，
                                       任一步不过自动回退（--no-compact 停在重建后，手动收尾）
  duckport ${CYAN}upgrade${NC} --finalize|--rollback  删除 / 恢复重建前的旧表
  duckport ${CYAN}upgrade${NC} --compact [--yes]      只做压缩：重建已完成、空间还没还给磁盘时（停 ingestor，换文件时短暂停服务端）

${BOLD}示例：${NC}
  duckport list                       # 查看可安装的插件
  duckport install binance_ingestor   # 安装 Binance 插件
  duckport config binance-5m          # 编辑 binance-5m 实例配置
  duckport rm binance-5m              # 删除 binance-5m 实例
  duckport start binance-5m           # 启动单个实例
  duckport logs binance-5m            # 查看该实例日志
  duckport loadhist binance-5m        # 补历史数据
"
}

# ─── dispatch ─────────────────────────────────────────────────────────────────

CMD="${1:-status}"
shift || true

case "$CMD" in
  list)     cmd_list ;;
  install)  cmd_install "${1:-}" ;;
  rm)       cmd_rm      "${1:-}" ;;
  update)   cmd_update  "${1:-}" ;;
  config)   cmd_config  "${1:-}" ;;
  status)   cmd_status ;;
  start)    cmd_start   "${1:-server}" ;;
  stop)     cmd_stop    "${1:-all}" ;;
  restart)  cmd_restart "${1:-all}" ;;
  logs)     cmd_logs    "${1:-}" ;;
  loadhist) cmd_loadhist "${1:-}" ;;
  retention) cmd_retention "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  upgrade)  cmd_upgrade "$@" ;;
  help|-h|--help) cmd_help ;;
  *) echo -e "${RED}未知命令：$CMD${NC}"; cmd_help; exit 1 ;;
esac
