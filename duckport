#!/usr/bin/env bash
# duckport — 服务管理 CLI
#
# 用法：
#   duckport list                        # 列出可用插件
#   duckport install <插件名>            # 安装插件实例
#   duckport rm      <实例名>            # 删除实例
#   duckport config  <实例名>            # 编辑实例配置
#   duckport status                      # 服务总览 + 水位
#   duckport start   [<实例>|all]        # 启动（默认 server）
#   duckport stop    [<实例>|all]        # 停止（默认 all）
#   duckport restart [<实例>|all]        # 重启（默认 all）
#   duckport logs    <实例>|server|all   # 实时日志
#   duckport update  <实例名>            # 更新插件（自动判断本地/GitHub）
#   duckport loadhist <实例>             # 补历史数据（必须指定实例）
#   duckport upgrade [--proxy URL]       # 升级：服务端 → 插件 → 数据对齐（--plan 只看计划）
#   duckport upgrade --data              # 只做数据对齐，含压缩（--no-compact、--finalize、--rollback）
#   duckport upgrade --compact           # 只做压缩：重建已完成但空间还没还给磁盘时
#   duckport doctor  [--deep] [--json]   # 对照当前版本检查库的状态（只读）

set -euo pipefail

# ─── 平台检测 ─────────────────────────────────────────────────────────────────

OS=$(uname -s)    # Linux | Darwin

# macOS 用用户路径（无需 sudo），Linux 用系统路径
if [[ "$OS" == "Darwin" ]]; then
  DEPLOY_OPT="${DUCKPORT_HOME:-$HOME/.duckport}"
  PLIST_DIR="$HOME/Library/LaunchAgents"
  LOG_DIR="$HOME/.duckport/logs"
  _DEFAULT_REPO="$HOME/code/duckport-rs"
else
  DEPLOY_OPT="${DUCKPORT_HOME:-/opt/duckport}"
  PLIST_DIR=""   # Linux 用 systemd，不需要
  LOG_DIR="/opt/duckport/logs"
  _DEFAULT_REPO="$HOME/code/duckport-rs"
fi

DEPLOY_BIN="$DEPLOY_OPT/bin"
# systemd unit 名前缀（deploy.sh 写入；同机第二套部署或演练环境用别的前缀，默认 duckport）
SVC_PREFIX="$(cat "$DEPLOY_OPT/unit_prefix" 2>/dev/null || echo duckport)"
SVC_SERVER="${SVC_PREFIX}-server"
SVC_INGESTOR="${SVC_PREFIX}-ingestor"
INGESTORS_DIR="$DEPLOY_OPT/ingestors"
# 从 deploy.sh 写入的持久化路径读取，回退到平台默认值
REPO_DIR="$(cat "$DEPLOY_OPT/repo_dir" 2>/dev/null || echo "$_DEFAULT_REPO")"

BOLD='\033[1m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; RED='\033[0;31m'; DIM='\033[2m'; NC='\033[0m'

# ─── 工具 ──────────────────────────────────────────────────────────────────────

_require_root() {
  # macOS 用户路径模式：所有操作在当前用户权限下即可完成
  [[ "$OS" == "Darwin" ]] && return
  [[ $EUID -eq 0 ]] || { echo -e "${RED}需要 root 权限，请用 sudo${NC}"; exit 1; }
}

# uv pip install 封装。默认清除 shell 代理（代理是给 ingestor 运行时用的）；设置了 DUCKPORT_PROXY
# （duckport upgrade --proxy）时改用它安装。支持 UV_INDEX_URL 指定 PyPI 镜像（如清华 https://pypi.tuna.tsinghua.edu.cn/simple/）
_uv_install() {
  local p="${DUCKPORT_PROXY:-}"
  HTTP_PROXY="$p" HTTPS_PROXY="$p" http_proxy="$p" https_proxy="$p" \
    uv pip install "$@"
}

# 将服务逻辑名转为 launchd label
_svc_label() {
  case "$1" in
    "$SVC_SERVER")       echo "com.duckport.server" ;;
    "$SVC_INGESTOR"@*)   echo "com.duckport.ingestor.${1#"$SVC_INGESTOR"@}" ;;
    *)                   echo "com.duckport.$1" ;;
  esac
}

# 查询服务是否 active，输出 "active" | "inactive"
_svc_is_active() {
  local svc="$1"
  if [[ "$OS" == "Linux" ]]; then
    systemctl is-active "$svc" 2>/dev/null || echo "inactive"
  else
    local label; label=$(_svc_label "$svc")
    # launchctl list <label> 有 "PID" 字段即为运行中
    if launchctl list "$label" 2>/dev/null | grep -q '"PID"'; then
      echo "active"
    else
      echo "inactive"
    fi
  fi
}

# 启动服务（macOS 用 bootstrap/kickstart 代替已废弃的 load）
_svc_start() {
  local svc="$1"
  if [[ "$OS" == "Linux" ]]; then
    systemctl start "$svc"
  else
    local label; label=$(_svc_label "$svc")
    local plist="$PLIST_DIR/${label}.plist"
    [[ -f "$plist" ]] || { echo -e "${RED}找不到 plist：$plist${NC}"; return 1; }
    local domain="gui/$(id -u)"
    # 若 plist 尚未注册，先 bootstrap（RunAtLoad=false 不会自动启动）
    if ! launchctl list "$label" &>/dev/null; then
      launchctl bootstrap "$domain" "$plist"
    fi
    # bootstrap 后或已注册时，kickstart 真正拉起进程
    launchctl kickstart "$domain/$label"
  fi
}

# 停止服务（macOS 用 bootout 代替已废弃的 unload）
_svc_stop() {
  local svc="$1"
  if [[ "$OS" == "Linux" ]]; then
    systemctl stop "$svc" 2>/dev/null || true
  else
    local label; label=$(_svc_label "$svc")
    local domain="gui/$(id -u)"
    launchctl bootout "$domain/$label" 2>/dev/null || true
  fi
}

_svc_status_label() {
  local state
  state=$(_svc_is_active "$SVC_INGESTOR@$1")
  case "$state" in
    active)   echo -e "${GREEN}● active${NC}" ;;
    inactive) echo -e "${DIM}○ inactive${NC}" ;;
    failed)   echo -e "${RED}✗ failed${NC}" ;;
    *)        echo -e "${YELLOW}? ${state}${NC}" ;;
  esac
}

_list_instances() {
  find "$INGESTORS_DIR" -maxdepth 2 -name "config.env" 2>/dev/null \
    | sed "s|$INGESTORS_DIR/||;s|/config.env||" | sort
}

_instance_python() {
  echo "$INGESTORS_DIR/$1/.venv/bin/python3"
}

_instance_exec() {
  local cfg="$INGESTORS_DIR/$1/config.env"
  grep '^INGESTOR_EXEC=' "$cfg" 2>/dev/null | cut -d= -f2 | tr -d '"' \
    || echo "binance-ingestor"
}

_resolve_instances() {
  local arg="${1:-all}"
  if [[ "$arg" == "all" || -z "$arg" ]]; then
    _list_instances
  else
    echo "$arg"
  fi
}

# 从 server.env 读取一项配置（去掉引号和空白）
_server_env() {
  grep "^$1=" "$DEPLOY_OPT/server.env" 2>/dev/null | tail -1 \
    | cut -d= -f2- | tr -d '"' | tr -d "'" | xargs
}

# 布尔配置的三态：输出 true | false | invalid（不区分大小写；兼容 macOS 自带的 bash 3.2）。
# 与 duckport-server 的解析一致：未设置取默认值，其他无法识别的值（含空值）视为 invalid。
_bool_state() {
  local value="${1-__unset__}" default="${2:-false}"
  [[ "$value" == "__unset__" ]] && { echo "$default"; return; }
  case "$(echo "$value" | tr '[:upper:]' '[:lower:]' | xargs)" in
    true|1|yes|on)  echo "true" ;;
    false|0|no|off) echo "false" ;;
    *)              echo "invalid" ;;
  esac
}

# duckport-server 监听端口（来自 DUCKPORT_LISTEN_ADDR，默认 50051）
_server_port() {
  local addr port
  addr=$(_server_env DUCKPORT_LISTEN_ADDR)
  addr="${addr:-0.0.0.0:50051}"
  port="${addr##*:}"
  echo "${port:-50051}"
}

# 带 pyarrow 的 Python：优先用第一个 ingestor 实例的 venv，回退到系统 python3
_flight_python() {
  local py candidate inst
  py=$(command -v python3)
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    candidate=$(_instance_python "$inst")
    if [[ -x "$candidate" ]]; then
      py="$candidate"
      break
    fi
  done <<< "$(_list_instances)"
  echo "$py"
}

# 已安装的插件实例清单（JSON 写入 $1）：实例名、插件命令、安装版本、是否运行中。
# 版本按 console script 名找到所属的发行包再读取，第三方插件同样适用。
# start_date：config.env 里的 START_DATE（插件补历史的起点），没有就留空；
# retention 用它判断补进来的历史会不会马上被删掉（scripts/reconcile/startgap.py）。
_instances_json() {
  local out="$1" inst first=1 exec_name ver active start
  echo "[" > "$out"
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    exec_name=$(_instance_exec "$inst")
    ver=$(_instance_version "$inst")
    [[ "$(_svc_is_active "$SVC_INGESTOR@$inst")" == "active" ]] && active=true || active=false
    start=$(grep -m1 '^START_DATE=' "$INGESTORS_DIR/$inst/config.env" 2>/dev/null \
            | cut -d= -f2- | tr -d "\"' ") || start=""
    [[ $first -eq 1 ]] && first=0 || echo "," >> "$out"
    printf '{"instance": "%s", "exec": "%s", "version": "%s", "active": %s, "start_date": "%s"}' \
      "$inst" "$exec_name" "$ver" "$active" "$start" >> "$out"
  done <<< "$(_list_instances)"
  echo "]" >> "$out"
}

# 查询正在运行的 duckport-server 版本（duckport.ping 的 server_version）。
_server_version() {
  local port="$1"
  local py
  py=$(_flight_python)

  "$py" - "$port" << 'PY' 2>/dev/null || true
import json
import sys

import pyarrow.flight as flight

port = sys.argv[1]
client = flight.FlightClient(f"grpc://127.0.0.1:{port}")
try:
    results = list(client.do_action(flight.Action("duckport.ping", b"")))
    info = json.loads(results[0].body.to_pybytes())
    version = info.get("server_version") or ""
    if version:
        print(version)
finally:
    client.close()
PY
}

# ─── status ───────────────────────────────────────────────────────────────────

cmd_status() {
  local server_addr server_port
  server_addr=$(grep '^DUCKPORT_LISTEN_ADDR=' "$DEPLOY_OPT/server.env" 2>/dev/null \
    | cut -d= -f2- | tr -d '"' | tr -d "'" | xargs)
  server_addr="${server_addr:-0.0.0.0:50051}"
  server_port="${server_addr##*:}"
  server_port="${server_port:-50051}"

  echo -e "\n${BOLD}duckport-server${NC}"
  local sv_state sv_label
  sv_state=$(_svc_is_active "$SVC_SERVER")
  if [[ "$sv_state" == "active" ]]; then
    sv_label="${GREEN}● active${NC}"
  else
    sv_label="${DIM}○ ${sv_state}${NC}"
  fi
  local version_label=""
  if nc -z localhost "$server_port" 2>/dev/null; then
    local ver
    ver=$(_server_version "$server_port")
    if [[ -n "$ver" ]]; then
      version_label="  ${DIM}v${ver}${NC}"
    fi
  fi
  printf "  %-22s " "$SVC_SERVER"
  echo -e "$sv_label  ${DIM}:${server_port}${NC}${version_label}"

  echo -e "\n${BOLD}Ingestors${NC}"
  local instances
  instances=$(_list_instances)
  if [[ -z "$instances" ]]; then
    echo -e "  ${DIM}（无已注册实例）${NC}"
  else
    while IFS= read -r inst; do
      local exec_name
      exec_name=$(_instance_exec "$inst")
      printf "  %-22s %s  ${DIM}[%s]${NC}\n" \
        "$inst" "$(_svc_status_label "$inst")" "$exec_name"
    done <<< "$instances"
  fi

  echo -e "\n${BOLD}Watermark${NC}"
  if ! nc -z localhost "$server_port" 2>/dev/null; then
    echo -e "  ${DIM}duckport-server 未监听 :${server_port}${NC}\n"
    return
  fi

  local status_py
  status_py=$(command -v python3)
  while IFS= read -r inst; do
    local candidate
    candidate=$(_instance_python "$inst")
    if [[ -x "$candidate" ]]; then
      status_py="$candidate"
      break
    fi
  done <<< "$([ -z "$instances" ] && echo "" || echo "$instances")"

  "$status_py" - "$server_port" << 'PYEOF' 2>/dev/null || {
import json
import sys
from datetime import timezone

import pandas as pd
import pyarrow.flight as flight

port = sys.argv[1]
client = flight.FlightClient(f"grpc://localhost:{port}")

def query(sql):
    ticket = json.dumps({"type": "duckport.query", "sql": sql}).encode("utf-8")
    return client.do_get(flight.Ticket(ticket)).read_all().to_pandas()

try:
    cols = query(
        "SELECT column_name FROM information_schema.columns "
        "WHERE table_schema = 'data' AND table_name = 'watermark'"
    )
    colset = set(cols["column_name"].astype(str)) if "column_name" in cols else set()
    ingestor_expr = "ingestor" if "ingestor" in colset else "NULL AS ingestor"
    max_lag_expr = "max_lag_seconds" if "max_lag_seconds" in colset else "NULL AS max_lag_seconds"
    wm = query(
        "SELECT "
        f"{ingestor_expr}, {max_lag_expr}, table_name, time_column, start_time, duck_time, updated_at "
        "FROM data.watermark "
        "ORDER BY COALESCE(ingestor, ''), table_name"
    )
except Exception as exc:
    print(f"  \033[2m无法读取 data.watermark: {exc}\033[0m")
    sys.exit(0)
finally:
    client.close()

if wm.empty:
    print("  \033[2m（无）\033[0m")
    sys.exit(0)

now = pd.Timestamp.now(tz=timezone.utc)

def _format_duration(seconds):
    seconds = max(0, int(seconds))
    h, r = divmod(seconds, 3600)
    m = r // 60
    return f"{h}h{m:02d}m" if h else f"{m}m"

def _infer_max_lag_seconds(table_name):
    if str(table_name).endswith("_funding"):
        return 9 * 3600
    parts = str(table_name).rsplit("_", 1)
    if len(parts) == 2 and parts[1].endswith("m") and parts[1][:-1].isdigit():
        return max(900, int(parts[1][:-1]) * 60 * 2)
    return 900

for _, row in wm.iterrows():
    ingestor = row.get("ingestor")
    ingestor = "unknown" if pd.isna(ingestor) or not str(ingestor) else str(ingestor)
    tname = row["table_name"]
    val = row["duck_time"]
    if pd.isna(val):
        print(f"  [{ingestor}] {tname:<22}: None")
        continue
    dt = pd.to_datetime(val)
    if dt.tzinfo is None:
        dt = dt.tz_localize(timezone.utc)
    else:
        dt = dt.tz_convert(timezone.utc)
    age = now - dt
    seconds = int(age.total_seconds())
    raw_max_lag = row.get("max_lag_seconds")
    if pd.isna(raw_max_lag) or int(raw_max_lag) <= 0:
        max_lag = _infer_max_lag_seconds(tname)
    else:
        max_lag = int(raw_max_lag)
    if seconds < 0:
        mark = "\033[1;33m⚠\033[0m"
        age_str = f"{_format_duration(abs(seconds))} ahead"
    else:
        mark = "\033[0;32m✓\033[0m" if seconds <= max_lag else "\033[1;33m⚠\033[0m"
        age_str = f"{_format_duration(seconds)} ago"
    print(f"  [{ingestor}] {tname:<22}: {dt.strftime('%Y-%m-%d %H:%M')} UTC  {mark} {age_str}")
PYEOF
    echo -e "  ${DIM}无法读取 data.watermark：缺少 pyarrow/pandas 或查询失败${NC}"
  }

  local ret_enabled ret_dry
  if grep -q '^DUCKPORT_RETENTION_ENABLED=' "$DEPLOY_OPT/server.env" 2>/dev/null; then
    ret_enabled=$(_bool_state "$(_server_env DUCKPORT_RETENTION_ENABLED)" false)
  else
    ret_enabled=false
  fi
  if grep -q '^DUCKPORT_RETENTION_DRY_RUN=' "$DEPLOY_OPT/server.env" 2>/dev/null; then
    ret_dry=$(_bool_state "$(_server_env DUCKPORT_RETENTION_DRY_RUN)" true)
  else
    ret_dry=true
  fi
  echo -e "\n${BOLD}Retention${NC}"
  if [[ "$ret_enabled" == "invalid" || "$ret_dry" == "invalid" ]]; then
    echo -e "  scheduler ${RED}✗ server.env 中 DUCKPORT_RETENTION_ENABLED / DRY_RUN 的值无效（只接受 true/false），服务端会拒绝启动${NC}"
  elif [[ "$ret_enabled" == "true" ]]; then
    if [[ "$ret_dry" == "true" ]]; then
      echo -e "  scheduler ${YELLOW}● dry-run${NC}  ${DIM}(DUCKPORT_RETENTION_DRY_RUN=false 才会真正删除)${NC}"
    else
      echo -e "  scheduler ${GREEN}● enabled${NC}"
    fi
  else
    echo -e "  scheduler ${DIM}○ disabled${NC}"
  fi
  "$status_py" "$REPO_DIR/scripts/retention.py" --addr "127.0.0.1:$server_port" status --brief 2>/dev/null \
    || echo -e "  ${DIM}无法读取 data.retention_policy（服务端版本低于 1.1.0？）${NC}"
  echo ""
}

# ─── doctor ───────────────────────────────────────────────────────────────────

# 对照当前版本的期望状态检查数据库，只读。退出码：0 一致，1 有待对齐项，2 有阻断项，3 检查失败。
cmd_doctor() {
  local port inv rc=0
  port=$(_server_port)
  nc -z localhost "$port" 2>/dev/null || { echo -e "${RED}duckport-server 未监听 :${port}${NC}"; exit 3; }
  inv=$(mktemp)
  _instances_json "$inv"
  "$(_flight_python)" "$REPO_DIR/scripts/doctor.py" --addr "127.0.0.1:$port" --instances-file "$inv" "$@" || rc=$?
  rm -f "$inv"
  return $rc
}

# ─── retention ────────────────────────────────────────────────────────────────

cmd_retention() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    status|set|disable|dry-run|run|log) ;;
    *) echo -e "${RED}用法：duckport retention [status|set|disable|dry-run|run|log] ...${NC}"; exit 1 ;;
  esac
  local port inv rc=0
  port=$(_server_port)
  nc -z localhost "$port" 2>/dev/null || { echo -e "${RED}duckport-server 未监听 :${port}${NC}"; exit 1; }
  inv=$(mktemp)
  if [[ "$sub" == "set" ]]; then _instances_json "$inv"; else echo "[]" > "$inv"; fi
  "$(_flight_python)" "$REPO_DIR/scripts/retention.py" --addr "127.0.0.1:$port" \
      --instances-file "$inv" "$sub" "$@" || rc=$?
  rm -f "$inv"
  return $rc
}

# 插件的起始日期远早于 retention 保留窗口时提醒：补进来的那段历史随后会被 retention 删掉。
# 参数原样交给 retention.py check（--instance X 或 --table T）。给出了提醒返回 1；
# 服务端没在跑、或检查本身失败时不提醒，返回 0——它只是提醒，不能挡住调用它的命令。
_start_gap_check() {
  local port inv rc=0
  port=$(_server_port)
  nc -z localhost "$port" 2>/dev/null || return 0
  inv=$(mktemp)
  _instances_json "$inv"
  "$(_flight_python)" "$REPO_DIR/scripts/retention.py" --addr "127.0.0.1:$port" \
      --instances-file "$inv" check "$@" || rc=$?
  rm -f "$inv"
  if [[ $rc -eq 1 ]]; then return 1; fi
  return 0
}

# ─── 停写窗口 ─────────────────────────────────────────────────────────────────

# 停掉正在运行的 ingestor（服务端不停），记下实例名；_start_stopped_ingestors 按原状态拉起。
# 调用方用 trap 保证中途退出时也会拉起。
STOPPED_INGESTORS=()
_stop_running_ingestors() {
  local inst
  STOPPED_INGESTORS=()
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    if [[ "$(_svc_is_active "$SVC_INGESTOR@$inst")" == "active" ]]; then
      STOPPED_INGESTORS+=("$inst")
      _svc_stop "$SVC_INGESTOR@$inst"
      echo -e "  ${DIM}stopped${NC} $inst"
    fi
  done <<< "$(_list_instances)"
}

_start_stopped_ingestors() {
  local inst
  for inst in ${STOPPED_INGESTORS[@]+"${STOPPED_INGESTORS[@]}"}; do
    _svc_start "$SVC_INGESTOR@$inst"
    echo -e "  ${GREEN}✓${NC} started $inst"
  done
  STOPPED_INGESTORS=()
}

# ─── start / stop / restart ───────────────────────────────────────────────────

cmd_start() {
  _require_root
  local arg="${1:-server}"

  if [[ "$arg" == "all" ]] || [[ "$arg" == "server" ]]; then
    _svc_start "$SVC_SERVER"
    echo -e "  ${GREEN}✓${NC} duckport-server started"
    [[ "$arg" == "server" ]] && return
    # 启动实例前要查库（见下）：等服务端监听，最多 30 秒
    local port i
    port=$(_server_port)
    for i in $(seq 1 30); do nc -z localhost "$port" 2>/dev/null && break; sleep 1; done
  fi

  # 循环的标准输入是实例列表，终端要在进循环前判断，提示从 /dev/tty 读
  local instances gap ans tty=0
  [[ -t 0 ]] && tty=1
  instances=$(_resolve_instances "$arg")
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    # 新实例、或实例新加的数据源：还没有数据的表一启动就从 START_DATE 补起
    gap=0
    _start_gap_check --instance "$inst" --fresh-only < /dev/null || gap=$?
    if [[ $gap -eq 1 && $tty -eq 1 ]]; then
      read -r -p "仍要启动 ${inst}？[y/N] " ans < /dev/tty
      if [[ ! "$ans" =~ ^[Yy]$ ]]; then
        echo -e "  ${YELLOW}跳过 $inst${NC}"
        continue
      fi
    fi
    _svc_start "$SVC_INGESTOR@$inst"
    echo -e "  ${GREEN}✓${NC} duckport-ingestor@$inst started"
  done <<< "$instances"
}

cmd_stop() {
  _require_root
  local arg="${1:-all}"

  if [[ "$arg" == "server" ]]; then
    _svc_stop "$SVC_SERVER"
    echo -e "  ${DIM}○${NC} duckport-server stopped"
    return
  fi

  local instances
  instances=$(_resolve_instances "$arg")
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    _svc_stop "$SVC_INGESTOR@$inst"
    echo -e "  ${DIM}○${NC} duckport-ingestor@$inst stopped"
  done <<< "$instances"

  if [[ "$arg" == "all" ]]; then
    _svc_stop "$SVC_SERVER"
    echo -e "  ${DIM}○${NC} duckport-server stopped"
  fi
}

cmd_restart() {
  _require_root
  local arg="${1:-all}"
  cmd_stop "$arg"
  sleep 1
  cmd_start "$arg"
}

# ─── logs ─────────────────────────────────────────────────────────────────────

cmd_logs() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo "用法: duckport logs <实例名>|server|all"; exit 1
  fi

  if [[ "$OS" == "Linux" ]]; then
    case "$target" in
      server)
        exec journalctl -u "$SVC_SERVER" -f --no-hostname -o short-iso ;;
      all)
        local units=("-u" "$SVC_SERVER")
        while IFS= read -r inst; do
          [[ -n "$inst" ]] && units+=("-u" "$SVC_INGESTOR@$inst")
        done <<< "$(_list_instances)"
        exec journalctl "${units[@]}" -f --no-hostname -o short-iso ;;
      *)
        exec journalctl -u "$SVC_INGESTOR@$target" -f --no-hostname -o short-iso ;;
    esac
  else
    # macOS：launchd 将 stdout/stderr 重定向到 LOG_DIR 下的文件
    case "$target" in
      server)
        exec tail -f "$LOG_DIR/server.log" "$LOG_DIR/server.err" ;;
      all)
        # 收集所有日志文件（server + 所有已注册实例）
        local log_files=("$LOG_DIR/server.log" "$LOG_DIR/server.err")
        while IFS= read -r inst; do
          [[ -n "$inst" ]] || continue
          [[ -f "$LOG_DIR/$inst.log" ]] && log_files+=("$LOG_DIR/$inst.log")
          [[ -f "$LOG_DIR/$inst.err" ]] && log_files+=("$LOG_DIR/$inst.err")
        done <<< "$(_list_instances)"
        exec tail -f "${log_files[@]}" ;;
      *)
        local lf="$LOG_DIR/$target.log"
        local ef="$LOG_DIR/$target.err"
        if [[ ! -f "$lf" && ! -f "$ef" ]]; then
          echo -e "${RED}找不到日志文件：$lf${NC}"
          echo "提示：服务必须已被启动过才会生成日志文件"
          exit 1
        fi
        local args=()
        [[ -f "$lf" ]] && args+=("$lf")
        [[ -f "$ef" ]] && args+=("$ef")
        exec tail -f "${args[@]}" ;;
    esac
  fi
}

# ─── list（registry 插件列表）────────────────────────────────────────────────

_registry_file() { echo "$REPO_DIR/ingestor/registry.json"; }

# 仓库内 ingestor/<插件名> 优先；否则回退到同级目录 duckport-<插件名>
_plugin_src() {
  local plugin="${1//_/-}"
  local in_repo="$REPO_DIR/ingestor/$plugin"
  local sibling
  sibling="$(dirname "$REPO_DIR")/duckport-${plugin}"
  if [[ -f "$in_repo/pyproject.toml" ]]; then
    echo "$in_repo"
  elif [[ -f "$sibling/pyproject.toml" ]]; then
    echo "$sibling"
  fi
}

_registry_get() {
  local plugin="${1//_/-}"
  local field="$2"
  local reg
  reg=$(_registry_file)
  python3 -c "
import json
try:
    data = json.load(open('$reg'))
    print(data.get('$plugin', {}).get('$field', ''))
except Exception:
    pass
" 2>/dev/null
}

_registry_config() {
  local plugin="${1//_/-}"
  local reg
  reg=$(_registry_file)
  REGISTRY_FILE="$reg" PLUGIN="$plugin" python3 <<'PY' 2>/dev/null
import json
import os
import re
import sys

reg = os.environ["REGISTRY_FILE"]
plugin = os.environ["PLUGIN"]
default_config = [
    {"name": "KLINE_INTERVAL", "label": "K 线周期", "default": "5m"},
    {"name": "DATA_SOURCES", "label": "DATA_SOURCES", "default": "usdt_perp,usdt_spot"},
    {"name": "CONCURRENCY", "label": "并发数", "default": "2"},
    {"name": "START_DATE", "label": "START_DATE", "default": "2021-01-01"},
    {"name": "PROXY_URL", "label": "PROXY_URL", "default": "", "empty_hint": "留空跳过"},
]

try:
    data = json.load(open(reg))
    config = data.get(plugin, {}).get("config") or default_config
except Exception:
    config = default_config

for item in config:
    name = str(item.get("name", ""))
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
        print(f"invalid config name for {plugin}: {name}", file=sys.stderr)
        sys.exit(1)
    label = str(item.get("label") or name)
    default = str(item.get("default", ""))
    empty_hint = str(item.get("empty_hint", ""))
    print("\x1f".join([name, label, default, empty_hint]))
PY
}

cmd_list() {
  local reg
  reg=$(_registry_file)
  if [[ ! -f "$reg" ]]; then
    echo -e "${RED}未找到插件注册表：$reg${NC}"; exit 1
  fi
  echo -e "\n${BOLD}可用插件${NC}  (注册表: $reg)\n"
  python3 -c "
import json
data = json.load(open('$reg'))
for name, info in data.items():
    installed = ''
    print(f'  \033[1m{name}\033[0m')
    print(f'    {info.get(\"description\",\"\")}')
    print(f'    repo: {info.get(\"repo\",\"\")}')
    print()
" 2>/dev/null || echo "  （无）"
  echo -e "用法: ${BOLD}duckport install <插件名>${NC}"
  echo ""
}

# ─── install（从 registry 安装插件实例）──────────────────────────────────────

cmd_install() {
  _require_root
  local plugin="${1:-}"
  [[ -n "$plugin" ]] || { echo "用法: duckport install <插件名>"; cmd_list; exit 1; }
  plugin="${plugin//_/-}"

  local reg
  reg=$(_registry_file)
  [[ -f "$reg" ]] || { echo -e "${RED}未找到插件注册表：$reg${NC}"; exit 1; }

  local repo exec_cmd default_inst desc
  repo=$(_registry_get "$plugin" repo)
  exec_cmd=$(_registry_get "$plugin" exec)
  default_inst=$(_registry_get "$plugin" default_instance)
  desc=$(_registry_get "$plugin" description)

  [[ -n "$repo" ]] || { echo -e "${RED}未知插件：$plugin${NC}\n"; cmd_list; exit 1; }

  echo -e "\n${BOLD}安装插件：$plugin${NC}"
  echo -e "  $desc"
  echo -e "  repo: $repo\n"

  read -rp "  实例名          (默认 ${default_inst:-$plugin}): " INST_NAME
  INST_NAME="${INST_NAME:-${default_inst:-$plugin}}"

  local inst_dir="$INGESTORS_DIR/$INST_NAME"
  local cfg="$inst_dir/config.env"

  if [[ -d "$inst_dir" ]]; then
    echo -e "${YELLOW}实例 '$INST_NAME' 已存在：$inst_dir${NC}"
    echo "如需重建，请先执行: duckport rm $INST_NAME"
    exit 1
  fi
  mkdir -p "$inst_dir"

  {
    echo "# 实例：$INST_NAME  插件：$plugin"
    echo "INGESTOR_EXEC=${exec_cmd:-$plugin}"
  } > "$cfg"

  local name label default_value empty_hint value hint prompt
  while IFS=$'\x1f' read -r -u 3 name label default_value empty_hint; do
    [[ -n "$name" ]] || continue
    if [[ -z "$default_value" && -n "$empty_hint" ]]; then
      hint="$empty_hint"
    else
      hint="默认 $default_value"
    fi
    printf -v prompt "  %-16s (%s): " "$label" "$hint"
    read -rp "$prompt" value
    value="${value:-$default_value}"
    printf '%s=%s\n' "$name" "$value" >> "$cfg"
  done 3< <(_registry_config "$plugin")
  printf 'INGESTOR_NAME=%s\n' "$INST_NAME" >> "$cfg"

  # 安装 Python 包
  echo -e "\n  安装 Python 环境..."
  export PATH="$HOME/.local/bin:$PATH"
  local python_bin python_ver
  python_bin=$(command -v python3.12 2>/dev/null || command -v python3)
  python_ver=$("$python_bin" --version | grep -oE '[0-9]+\.[0-9]+'  | head -1)
  uv venv --python "$python_ver" "$inst_dir/.venv" -q

  local inst_py="$inst_dir/.venv/bin/python3"
  # 优先仓库内或同级目录源码，否则从 git 安装
  local local_src
  local_src="$(_plugin_src "$plugin")"
  if [[ -n "$local_src" ]]; then
    echo -e "  使用本地源码：$local_src"
    _uv_install -e "$local_src" --python "$inst_py"
  else
    _uv_install "git+${repo}" --python "$inst_py"
  fi

  if [[ "$OS" == "Linux" ]]; then
    systemctl daemon-reload
    systemctl enable "$SVC_INGESTOR@$INST_NAME" 2>/dev/null || true
  else
    # macOS：launchd 无模板 unit，为每个实例生成独立 plist
    local label="com.duckport.ingestor.$INST_NAME"
    cat > "$PLIST_DIR/${label}.plist" << PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${DEPLOY_BIN}/ingestor-run</string>
    <string>${INST_NAME}</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>${LOG_DIR}/${INST_NAME}.log</string>
  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/${INST_NAME}.err</string>
  <key>WorkingDirectory</key>
  <string>${INGESTORS_DIR}/${INST_NAME}</string>
</dict>
</plist>
PLISTEOF
    echo -e "  ${GREEN}✓${NC} plist 已创建：$PLIST_DIR/${label}.plist"
  fi

  echo -e "\n  ${GREEN}✓${NC} 实例 '${INST_NAME}' 安装完成"
  echo -e "  配置文件：$cfg"
  echo -e "  编辑配置：${BOLD}duckport config $INST_NAME${NC}"
  echo -e "  启动服务：${BOLD}duckport start $INST_NAME${NC}"
  _start_gap_check --instance "$INST_NAME" || true
}

# ─── config（打开实例配置文件）───────────────────────────────────────────────

cmd_config() {
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "用法: duckport config <实例名>"; exit 1; }
  name="${name//_/-}"

  local cfg="$INGESTORS_DIR/$name/config.env"
  if [[ ! -f "$cfg" ]]; then
    echo -e "${RED}未找到实例配置：$cfg${NC}"
    echo "已注册实例："
    _list_instances | sed 's/^/  /'
    exit 1
  fi

  ${EDITOR:-nano} "$cfg"
  _start_gap_check --instance "$name" || true
}

# ─── rm（删除实例）───────────────────────────────────────────────────────────

cmd_rm() {
  _require_root
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "用法: duckport rm <实例名>"; exit 1; }
  name="${name//_/-}"

  local inst_dir="$INGESTORS_DIR/$name"
  [[ -d "$inst_dir" ]] || { echo -e "${RED}实例 '$name' 不存在${NC}"; exit 1; }

  read -rp "确认删除实例 '$name'？[y/N] " CONFIRM
  [[ "$CONFIRM" =~ ^[Yy]$ ]] || { echo "已取消"; exit 0; }

  _svc_stop "$SVC_INGESTOR@$name"
  if [[ "$OS" == "Linux" ]]; then
    systemctl disable "$SVC_INGESTOR@$name" 2>/dev/null || true
  else
    rm -f "$PLIST_DIR/com.duckport.ingestor.${name}.plist"
  fi
  rm -rf "$inst_dir"
  echo -e "  ${GREEN}✓${NC} 实例 '$name' 已删除"
}

# ─── loadhist ─────────────────────────────────────────────────────────────────

cmd_loadhist() {
  _require_root
  local inst="${1:-}" py cfg bin gap=0 ans
  if [[ -z "$inst" ]]; then
    echo -e "${RED}用法：duckport loadhist <实例名>${NC}"
    echo "已注册实例："
    _list_instances | sed 's/^/  /'
    exit 1
  fi
  py=$(_instance_python "$inst")
  cfg="$INGESTORS_DIR/$inst/config.env"
  bin="$INGESTORS_DIR/$inst/.venv/bin/loadhist"
  if [[ ! -x "$py" || ! -f "$cfg" ]]; then
    echo -e "${RED}未找到实例或环境不完整：$inst${NC}"
    echo "已注册实例："
    _list_instances | sed 's/^/  /'
    exit 1
  fi
  # 先检查再停实例：没有 loadhist 的插件（例如 binance-funding 自己在启动时补历史）不该被停掉
  if [[ ! -x "$bin" ]]; then
    echo -e "${YELLOW}${inst}（$(_instance_exec "$inst")）没有 loadhist，未做任何操作，实例未停止${NC}"
    exit 1
  fi

  _start_gap_check --instance "$inst" || gap=$?
  if [[ $gap -eq 1 && -t 0 ]]; then
    read -r -p "仍要补历史？[y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "已取消，$inst 未停止"; exit 0; }
  fi

  echo -e "\n${BOLD}▶ loadhist — $inst${NC}"
  echo -e "  ${YELLOW}⚠ 停止 ingestor 以独占 staging 表${NC}"
  _svc_stop "$SVC_INGESTOR@$inst"

  INGESTOR_ENV_FILE="$cfg" "$bin" && \
    echo -e "  ${GREEN}✓ loadhist 完成${NC}" || \
    echo -e "  ${RED}✗ loadhist 失败${NC}"

  echo -e "  ${YELLOW}提示：请手动执行 duckport start $inst 以恢复采集${NC}"
}

# ─── update（更新插件）────────────────────────────────────────────────────────

# 实例安装的插件版本：按 console script 名找到所属的发行包再读取，第三方插件同样适用；读不到时为空
_instance_version() {
  local py exec_name
  py=$(_instance_python "$1")
  exec_name=$(_instance_exec "$1")
  [[ -x "$py" ]] || return 0
  "$py" - "$exec_name" 2>/dev/null << 'PY' || true
import sys
from importlib import metadata
name = sys.argv[1]
for dist in metadata.distributions():
    if any(ep.group == "console_scripts" and ep.name == name for ep in dist.entry_points):
        print(dist.version)
        break
PY
}

# 实例插件的来源：本地源码目录，或 registry 里的 git 仓库（git+URL）；找不到时为空
_instance_source() {
  local exec_cmd reg plugin_name="" repo="" local_src
  exec_cmd=$(_instance_exec "$1")
  reg=$(_registry_file)
  if [[ -f "$reg" ]]; then
    read -r plugin_name repo < <(REG="$reg" EXEC="$exec_cmd" python3 -c "
import json, os
try:
    for k, v in json.load(open(os.environ['REG'])).items():
        if v.get('exec', '') == os.environ['EXEC']:
            print(k, v.get('repo', '')); break
except Exception:
    pass
" 2>/dev/null) || true
  fi
  local_src="$(_plugin_src "${plugin_name:-$exec_cmd}")"
  if [[ -n "$local_src" ]]; then
    echo "$local_src"
  elif [[ -n "$repo" ]]; then
    echo "git+$repo"
  fi
}

# 从来源重新安装实例的插件（不重启）
_update_instance() {
  local name="$1"
  local inst_dir="$INGESTORS_DIR/$name"
  [[ -d "$inst_dir" ]] || { echo -e "${RED}实例 '$name' 不存在${NC}"; exit 1; }
  local inst_py="$inst_dir/.venv/bin/python3"
  [[ -x "$inst_py" ]] || { echo -e "${RED}实例 '$name' 的 venv 不完整，请重新执行 duckport install${NC}"; exit 1; }

  export PATH="$HOME/.local/bin:$PATH"
  echo -e "\n${BOLD}更新实例：$name${NC}  (exec=$(_instance_exec "$name"))"
  local src
  src=$(_instance_source "$name")
  case "$src" in
    "")
      echo -e "${RED}无法确定插件来源（registry 中未找到 exec=$(_instance_exec "$name")）${NC}"
      exit 1 ;;
    git+*)
      echo -e "  ${CYAN}GitHub 模式：${src#git+}${NC}"
      _uv_install --reinstall "$src" --python "$inst_py" ;;
    "$REPO_DIR"/*)
      echo -e "  ${CYAN}仓库内源码：$src${NC}"
      _uv_install -e "$src" --python "$inst_py" ;;
    *)
      echo -e "  ${CYAN}本地源码模式：$src${NC}"
      git -C "$src" pull --ff-only
      _uv_install -e "$src" --python "$inst_py" ;;
  esac
  echo -e "  ${GREEN}✓${NC} 插件已更新"
}

cmd_update() {
  _require_root
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "用法: duckport update <实例名>"; exit 1; }
  name="${name//_/-}"
  _update_instance "$name"
  echo -e "  ${YELLOW}提示：请手动执行 duckport restart $name 以使新版本生效${NC}"
}

# ─── upgrade ──────────────────────────────────────────────────────────────────

# 升级：服务端 → 插件 → 数据，升到仓库当前版本（或 --to 指定的 tag），可重复执行。
#   sudo duckport upgrade [--yes] [--proxy URL] [--to vX.Y.Z] [--no-backup] [--delete-bad-rows]
#       1 服务端：git pull（或 checkout tag）→ deploy.sh 取 v<版本> 的 binary（没有 release 时本机编译）
#                 → binary 或运行中的版本变了就重启服务端，期间停 ingestor
#       2 插件：每个实例从 registry 的来源重装；版本变了就重启（第 1 步停掉的在这里启动）
#       3 数据：同 --data
#   duckport upgrade --plan [--to vX.Y.Z]       三个阶段各会做什么，不修改（会 git fetch）
#   sudo duckport upgrade --data [--yes] [--deep] [--no-backup] [--no-compact] [--delete-bad-rows]
#                                               只做第 3 步：只有在线修正时直接执行；需要停写时在一个窗口里
#                                               （只停 ingestor）先备份到 <库目录>/backup/，再修正，最后复检
#   sudo duckport upgrade --finalize            删除重建留下的 <表>__pk_old
#   sudo duckport upgrade --rollback            把 <表>__pk_old 恢复为原表（停写）
#   sudo duckport upgrade --compact [--yes]     只做重建之后的收尾：校验 → 删 <表>__pk_old → 整库重写 → 换文件
#                                               （上次换文件失败回退了、或用旧版 CLI 做过 finalize 的机器）
# 发生重建时，复检通过后同一条命令继续：校验重建结果 → 删除 <表>__pk_old → 整库重写压缩 →
# 换文件并校验 → 删除换下的原文件。校验不过就用 <表>__pk_old 回退，换文件后校验不过就把原文件换回去。
# --no-compact 停在重建之后，保留 <表>__pk_old，由 --finalize / --rollback 手动收尾。
# --proxy 作用于 git、下载 release 和安装插件（uv）；本机的 gRPC 连接不走代理。
# 磁盘或内存不够备份时给出警告，输入 go on without backup 才继续（--no-backup 跳过备份）。
# 损坏或重复的行先列出样例，人工确认后才删除；--yes 不包括这一项（--delete-bad-rows 才包括）。
# 每一步记入 data.upgrade_log；删除的行先导出到 <库目录>/quarantine/<run_id>/。
cmd_upgrade() {
  local mode="full" yes=0 no_backup=0 no_compact=0 delete_bad=0 after_pull=0 to="" proxy="" extra=() plan_args=()
  local orig_args=("$@")
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)     mode="plan" ;;
      --data)     mode="data" ;;
      --finalize) mode="finalize" ;;
      --rollback) mode="rollback" ;;
      --compact)  mode="compact" ;;
      --yes|-y)   yes=1 ;;
      --no-backup) no_backup=1 ;;
      --no-compact) no_compact=1 ;;
      --delete-bad-rows) delete_bad=1 ;;
      --deep)     extra+=(--deep) ;;
      --to)       to="${2:?--to 需要一个 tag，如 v1.2.0}"; shift ;;
      --proxy)    proxy="${2:?--proxy 需要代理地址，如 http://localhost:1082}"; shift ;;
      --after-pull) after_pull=1 ;;   # 内部使用：仓库已更新，由新的 CLI 继续
      *) echo -e "${RED}未知参数：$1${NC}"; exit 1 ;;
    esac
    shift
  done
  [[ -n "$proxy" ]] && _use_proxy "$proxy"

  case "$mode" in
    full)
      _require_root
      if [[ $after_pull -eq 0 ]]; then
        _upgrade_repo
        # 后面的步骤用刚更新的 CLI 和脚本执行
        exec bash "$REPO_DIR/duckport" upgrade --after-pull ${orig_args[@]+"${orig_args[@]}"}
      fi
      _upgrade_server_and_plugins
      echo -e "\n${BOLD}▶ 3/3 数据对齐${NC}"
      mode="data"
      ;;
    plan)
      _upgrade_plan_stages
      echo -e "\n${BOLD}▶ 3/3 数据对齐${NC}（按插件升级后的版本估计）"
      plan_args=(--assume-upgraded)
      ;;
  esac
  _upgrade_db
  # 由旧版 CLI 的 upgrade 经 deploy.sh 交过来：它收尾时还会打印过时的「duckport restart」。
  # 失败时 set -e 在上一行就退出了，旧版 CLI 也随之中止，不会走到它那句提示。
  if [[ -n "${DUCKPORT_HANDOFF:-}" ]]; then
    echo -e "\n${DIM}旧版 CLI 接下来会提示执行 duckport restart：不需要，升级已经在上面完成。${NC}"
  fi
}

# 本次执行的网络代理（git、curl、uv）；本机地址不走代理（pyarrow 的 gRPC 也读这些变量）
_use_proxy() {
  export DUCKPORT_PROXY="$1"
  export http_proxy="$1" https_proxy="$1" HTTP_PROXY="$1" HTTPS_PROXY="$1"
  export no_proxy="localhost,127.0.0.1,::1${no_proxy:+,$no_proxy}"
  export NO_PROXY="$no_proxy"
}

_git_pull() {
  local dir="$1" branch
  branch=$(git -C "$dir" branch --show-current)
  if git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$dir" pull --ff-only
  elif [[ -n "$branch" ]] && git -C "$dir" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
    echo -e "  ${YELLOW}当前分支未设置 upstream，改用 origin/$branch${NC}"
    git -C "$dir" pull --ff-only origin "$branch"
  else
    echo -e "  ${YELLOW}当前分支未设置 upstream，跳过 git pull，使用本地 checkout${NC}"
  fi
}

_upgrade_repo() {
  [[ -d "$REPO_DIR/.git" ]] || { echo -e "${RED}未找到仓库：$REPO_DIR${NC}"; exit 1; }
  echo -e "\n${BOLD}▶ 更新仓库${NC} $REPO_DIR"
  if [[ -n "$to" ]]; then
    git -C "$REPO_DIR" fetch --tags origin
    git -C "$REPO_DIR" -c advice.detachedHead=false checkout "$to"
  else
    _git_pull "$REPO_DIR"
  fi
}

# 仓库（或某个 git 版本）里的 duckport-rs 版本号
_repo_version() {
  local rev="${1:-}"
  if [[ -n "$rev" ]]; then
    git -C "$REPO_DIR" show "$rev:Cargo.toml" 2>/dev/null
  else
    cat "$REPO_DIR/Cargo.toml"
  fi | grep -m1 '^version = ' | cut -d'"' -f2
}

_md5() {
  if [[ "$OS" == "Darwin" ]]; then md5 -q "$1" 2>/dev/null; else md5sum "$1" 2>/dev/null | cut -d' ' -f1; fi
}

# 等服务端监听并报告期望的版本（最多 120 秒）
_wait_server() {
  local port="$1" want="$2" i
  for i in $(seq 1 120); do
    if nc -z localhost "$port" 2>/dev/null && [[ "$(_server_version "$port")" == "$want" ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# 停服务端并等它真的退出。macOS 的 launchctl bootout 不等进程结束，而 duckport-server
# 收到 SIGTERM 后要先做 checkpoint，库大时要一会儿；这期间端口还占着，马上拉起的新进程
# 因为端口被占而退出——launchd 只重启崩溃的进程，于是服务端就一直没起来。
# Linux 的 systemctl stop 自己会等（超时则 kill），这里的等待只是兜底。
_stop_server_and_wait() {
  local port="$1" timeout="${2:-300}" i
  _svc_stop "$SVC_SERVER"
  for ((i = 0; i < timeout; i++)); do
    if ! nc -z localhost "$port" 2>/dev/null && ! pgrep -f "^${DEPLOY_BIN}/duckport-server" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  echo -e "${RED}duckport-server 停了 ${timeout}s 还没退出（:${port} 仍被占用）${NC}"
  return 1
}

# 服务端最近的日志，用于说明它为什么没起来
_server_log_tail() {
  echo -e "  ${DIM}服务端最近的日志：${NC}"
  if [[ "$OS" == "Linux" ]]; then
    journalctl -u "$SVC_SERVER" -n 20 --no-pager -o short-iso 2>/dev/null | sed 's/^/    /'
  else
    tail -n 20 "$LOG_DIR/server.err" "$LOG_DIR/server.log" 2>/dev/null | sed 's/^/    /'
  fi
}

_upgrade_server_and_plugins() {
  local want port before after running inst v0 v1 restart=()
  want="${to#v}"
  [[ -n "$want" ]] || want=$(_repo_version)
  port=$(_server_port)

  echo -e "\n${BOLD}▶ 1/3 服务端${NC}（目标 v${want}）"
  before=$(_md5 "$DEPLOY_BIN/duckport-server")
  DEPLOY_OPT="$DEPLOY_OPT" DUCKPORT_UNIT_PREFIX="$SVC_PREFIX" RELEASE_TAG="v${want}" bash "$REPO_DIR/deploy.sh"
  after=$(_md5 "$DEPLOY_BIN/duckport-server")
  running=$(_server_version "$port")
  # 中途失败也要把停掉的 ingestor 拉起来
  trap _start_stopped_ingestors EXIT
  if [[ "$before" != "$after" || "$running" != "$want" ]]; then
    echo -e "\n  重启服务端：${running:+v}${running:-未运行} → v${want}（先停 ingestor，插件升级后再启动）"
    _stop_running_ingestors
    _stop_server_and_wait "$port" || exit 1
    _svc_start "$SVC_SERVER"
    if ! _wait_server "$port" "$want"; then
      echo -e "${RED}duckport-server 没有以 v${want} 启动（当前：$(_server_version "$port")）${NC}"
      _server_log_tail
      exit 1
    fi
    echo -e "  ${GREEN}✓${NC} duckport-server v${want} 已启动"
  else
    echo -e "  ${GREEN}✓${NC} 已是 v${want}，不需要重启"
  fi

  echo -e "\n${BOLD}▶ 2/3 插件${NC}"
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    v0=$(_instance_version "$inst")
    _update_instance "$inst"
    v1=$(_instance_version "$inst")
    echo -e "  ${inst}：v${v0:-?} → v${v1:-?}"
    if [[ "$v0" != "$v1" && "$(_svc_is_active "$SVC_INGESTOR@$inst")" == "active" ]]; then
      restart+=("$inst")
    fi
  done <<< "$(_list_instances)"
  for inst in ${restart[@]+"${restart[@]}"}; do
    _svc_stop "$SVC_INGESTOR@$inst"
    _svc_start "$SVC_INGESTOR@$inst"
    echo -e "  ${GREEN}✓${NC} restarted $inst"
  done
  _start_stopped_ingestors
  trap - EXIT
}

_upgrade_plan_stages() {
  local target want running port behind inst any=0
  echo -e "${BOLD}▶ 1/3 服务端${NC}"
  if [[ -d "$REPO_DIR/.git" ]]; then
    git -C "$REPO_DIR" fetch -q --tags origin 2>/dev/null || echo -e "  ${YELLOW}git fetch 失败，按本地仓库估计${NC}"
    target="${to:-$(git -C "$REPO_DIR" rev-parse --abbrev-ref '@{u}' 2>/dev/null || echo HEAD)}"
    want=$(_repo_version "$target")
    behind=$(git -C "$REPO_DIR" rev-list --count "HEAD..$target" 2>/dev/null || echo "?")
    echo -e "  仓库 ${REPO_DIR}：$(git -C "$REPO_DIR" rev-parse --short HEAD) → ${target}（${behind} 个新提交）"
  else
    want=$(_repo_version)
    echo -e "  ${YELLOW}$REPO_DIR 不是 git 仓库，按当前文件估计${NC}"
  fi
  port=$(_server_port)
  running=$(_server_version "$port")
  if [[ "$running" == "$want" ]]; then
    echo -e "  duckport-server v${running}：已是目标版本（binary 有变化时仍会重启）"
  else
    echo -e "  duckport-server v${running:-?（未运行）} → v${want:-?}：替换 binary 并重启，期间停 ingestor"
  fi
  echo -e "\n${BOLD}▶ 2/3 插件${NC}"
  while IFS= read -r inst; do
    [[ -z "$inst" ]] && continue
    any=1
    echo -e "  ${inst}（$(_instance_exec "$inst") v$(_instance_version "$inst")）：从 $(_instance_source "$inst") 重装，版本变化时重启"
  done <<< "$(_list_instances)"
  [[ $any -eq 1 ]] || echo -e "  （无已注册实例）"
}

# 数据阶段：--plan（数据部分）/ --data / --finalize / --rollback；用调用方的 mode、yes 等变量
_upgrade_db() {
  local port py db inv run_id rc=0
  port=$(_server_port)
  py=$(_flight_python)
  db=$(_server_env DUCKPORT_DB_PATH)
  nc -z localhost "$port" 2>/dev/null || { echo -e "${RED}duckport-server 未监听 :${port}${NC}"; exit 3; }
  run_id="$(date +%Y%m%d-%H%M%S)-$$"   # 同一秒内的两次执行不能共用备份和隔离目录
  inv=$(mktemp)
  local base=("$py" "$REPO_DIR/scripts/upgrade.py" --addr "127.0.0.1:$port" --db-path "$db"
              --run-id "$run_id" --instances-file "$inv" ${extra[@]+"${extra[@]}"})

  case "$mode" in
    compact)
      _require_root
      rm -f "$inv"
      _compact_prepare "$db" || return 1
      if [[ $yes -ne 1 ]]; then
        echo -e "${YELLOW}压缩会停止所有 ingestor，并在换文件时短暂停服务端。${NC}"
        read -r -p "执行？[y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "已取消"; return 0; }
      fi
      _finish_rebuild "$py" "$port" "$db" "$run_id"
      return $?
      ;;
    plan)
      _instances_json "$inv"
      "${base[@]}" plan ${plan_args[@]+"${plan_args[@]}"} || rc=$?
      rm -f "$inv"
      [[ $rc -eq 4 || $rc -eq 5 ]] && rc=1   # 对外：0 已对齐，1 有待修正，2 阻断，3 失败
      return $rc
      ;;
    finalize)
      _require_root
      "${base[@]}" finalize || rc=$?
      rm -f "$inv"
      return $rc
      ;;
    rollback)
      _require_root
      echo -e "${YELLOW}回退期间会停止所有 ingestor${NC}"
      if [[ $yes -ne 1 ]]; then
        read -r -p "继续？[y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { echo "已取消"; rm -f "$inv"; exit 0; }
      fi
      trap _start_stopped_ingestors EXIT
      _stop_running_ingestors
      "${base[@]}" rollback || rc=$?
      _start_stopped_ingestors
      trap - EXIT
      rm -f "$inv"
      return $rc
      ;;
  esac

  _require_root
  _instances_json "$inv"
  local plan_rc=0 st DELETE_ROWS=0
  st=$(mktemp)
  "${base[@]}" plan --state-out "$st" || plan_rc=$?
  # shellcheck disable=SC1090
  source "$st"
  rm -f "$st"
  case $plan_rc in
    0) echo -e "\n${GREEN}✓ 已与期望状态一致，无需修改${NC}"; rm -f "$inv"; return 0 ;;
    1|4|5) ;;
    *) rm -f "$inv"; return $plan_rc ;;
  esac

  # 损坏或重复的行：样例已在计划里列出，删除前必须人工确认
  local delete_args=() declined=0
  if [[ ${DELETE_ROWS:-0} -gt 0 ]]; then
    if [[ $delete_bad -eq 1 ]]; then
      delete_args=(--confirm-delete)
    elif [[ $yes -eq 1 ]]; then
      declined=1
      echo -e "\n${YELLOW}--yes 不包括删除损坏/重复的行，这 ${DELETE_ROWS} 行保留（确认删除：--delete-bad-rows）${NC}"
    else
      read -r -p "确认删除上面列出的 ${DELETE_ROWS} 行损坏/重复数据？（先导出到隔离文件）[y/N] " ans
      if [[ "$ans" =~ ^[Yy]$ ]]; then
        delete_args=(--confirm-delete)
      else
        declined=1
        echo "  这些行保留，其他修正照常执行"
      fi
    fi
  fi

  local window=0 confirmed=$yes backup_args=(--backup)
  [[ $plan_rc -ge 4 ]] && window=1
  if [[ $window -eq 1 && $no_backup -eq 1 ]]; then
    backup_args=()
    echo -e "\n${YELLOW}--no-backup：停写窗口里不做备份${NC}"
  elif [[ $plan_rc -eq 5 ]]; then
    backup_args=()
    echo -e "\n${YELLOW}⚠ 磁盘或内存不足，无法在停写窗口里备份（原因见上）。${NC}"
    echo -e "${YELLOW}  不备份也能回退：重建的表保留为 <表>__pk_old，删除的行导出在 quarantine 目录。${NC}"
    read -r -p "确认不备份继续，请输入 go on without backup：" ans
    [[ "$ans" == "go on without backup" ]] || { echo "已取消"; rm -f "$inv"; exit 0; }
    confirmed=1
  fi
  if [[ $confirmed -ne 1 ]]; then
    if [[ $window -eq 1 ]]; then
      echo -e "\n${YELLOW}停写窗口会停止所有 ingestor（服务端不停）。${NC}"
    fi
    read -r -p "执行？[y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "已取消"; rm -f "$inv"; exit 0; }
  fi

  local failed=0
  if [[ $window -eq 0 ]]; then
    echo -e "\n${BOLD}在线修正${NC}"
    "${base[@]}" apply --levels online ${delete_args[@]+"${delete_args[@]}"} || failed=1
  else
    # 备份要在任何修改之前完成，所以在线修正也放进窗口
    echo -e "\n${BOLD}停写窗口${NC}"
    trap _start_stopped_ingestors EXIT
    _stop_running_ingestors
    _instances_json "$inv"
    "${base[@]}" apply --levels online,stop ${backup_args[@]+"${backup_args[@]}"} \
      ${delete_args[@]+"${delete_args[@]}"} || failed=1
    _start_stopped_ingestors
    trap - EXIT
  fi

  echo -e "\n${BOLD}复检${NC}"
  _instances_json "$inv"
  local doctor_rc=0
  "$py" "$REPO_DIR/scripts/doctor.py" --addr "127.0.0.1:$port" --instances-file "$inv" \
    ${extra[@]+"${extra[@]}"} || doctor_rc=$?
  rm -f "$inv"
  if [[ $failed -eq 0 && $doctor_rc -eq 1 && $declined -eq 1 ]]; then
    echo -e "\n${YELLOW}损坏/重复的行未经确认，没有删除（复检里的 D1/D2）。各步骤结果见 data.upgrade_log（run_id=${run_id}）。${NC}"
    echo -e "  确认后：sudo duckport upgrade --data（交互确认）或加 --delete-bad-rows"
    return 1
  fi
  if [[ $failed -ne 0 || $doctor_rc -ne 0 ]]; then
    echo -e "\n${RED}仍有未对齐的项。各步骤结果见 data.upgrade_log（run_id=${run_id}）；处理后可再次执行。${NC}"
    return 1
  fi
  echo -e "\n${GREEN}✓ 对齐完成${NC}（run_id=${run_id}）"
  [[ $window -eq 1 ]] || return 0
  if [[ ${#backup_args[@]} -gt 0 ]]; then
    echo -e "  备份：$(dirname "$db")/backup/duckport-${run_id}.db（恢复：停服后替换 ${db}，删除 ${db}.wal）；不再需要时手动删除"
  fi

  _finish_rebuild "$py" "$port" "$db" "$run_id"
}

# 重建之后的收尾，也是 --compact 的全部：重建留下的 <表>__pk_old 是迁移的备份，校验通过就
# 删掉它们并把库压实，校验不过就用它们回退——两条路都在这一条命令里走完。没有旧表时
# （已经 finalize 过）校验直接通过，只做压缩。用调用方的 no_compact。
_finish_rebuild() {
  local py="$1" port="$2" db="$3" run_id="$4"
  echo -e "\n${BOLD}校验重建${NC}"
  if ! "$py" "$REPO_DIR/scripts/upgrade.py" --addr "127.0.0.1:$port" --db-path "$db" \
       --run-id "$run_id" compact-verify; then
    echo -e "\n${RED}重建校验未通过，正在用 <表>__pk_old 回退${NC}"
    trap _start_stopped_ingestors EXIT
    _stop_running_ingestors
    "$py" "$REPO_DIR/scripts/upgrade.py" --addr "127.0.0.1:$port" --db-path "$db" \
        --run-id "$run_id" rollback || true
    _start_stopped_ingestors
    trap - EXIT
    echo -e "${YELLOW}已回到重建之前的数据；原因见上，处理后可再次执行。${NC}"
    return 1
  fi
  if [[ $no_compact -eq 1 ]]; then
    echo -e "  ${YELLOW}--no-compact：保留 <表>__pk_old，未压缩${NC}"
    echo -e "  需要时：sudo duckport upgrade --finalize（删除旧表）；有问题：--rollback"
    return 0
  fi
  _compact_db "$py" "$port" "$db" "$run_id"
}

# --compact 前的清场。<库>.preswap 说明上次换文件到一半没换回来，得人看；<库>.compact 是
# 上次换文件失败后留下的新文件，原库之后又写入了，它已经过时，确认后删掉重来。
_compact_prepare() {
  local db="$1" ans
  local newdb="${db}.compact" bak="${db}.preswap"   # 另起一行：同一条 local 里 ${db} 取的是外层的值
  if [[ -e "$bak" ]]; then
    echo -e "${RED}存在 ${bak}：上次换文件没有完成回退。先人工确认 ${db} 是哪一份，再继续。${NC}"
    return 1
  fi
  if [[ -e "$newdb" ]]; then
    echo -e "${YELLOW}存在上次压缩失败留下的 ${newdb}（$(du -h "$newdb" | cut -f1)，$(date -r "$newdb" '+%F %T')）。${NC}"
    echo -e "${YELLOW}原库之后已继续写入，这份已经过时。${NC}"
    if [[ $yes -ne 1 ]]; then
      read -r -p "删除它并重新压缩？[y/N] " ans
      [[ "$ans" =~ ^[Yy]$ ]] || { echo "已取消"; return 1; }
    fi
    rm -f "$newdb" "$newdb.wal"
    echo -e "  已删除 ${newdb}"
  fi
  return 0
}

# 压缩：删除重建留下的 <表>__pk_old，并把整库重写成一个新文件。
# DROP 只把 block 标记为空闲供后续写入复用，库文件本身不会变小；只有整库重写才真正把空间还给磁盘。
# 重写期间原文件不动，它就是这一步的备份——换文件后校验通过才删，失败就换回去，
# 所以库再大也不必先为自己腾出一份等大的拷贝。调用方需已 _require_root。
_compact_db() {
  local py="$1" port="$2" db="$3" run_id="$4"
  local newdb="${db}.compact" bak="${db}.preswap" wal="${db}.wal"
  local base ver
  base=$(mktemp)
  ver=$(_server_version "$port")

  echo -e "\n${BOLD}压缩${NC}（停 ingestor；换文件时短暂停服务端）"
  trap _start_stopped_ingestors EXIT
  _stop_running_ingestors
  if ! "$py" "$REPO_DIR/scripts/upgrade.py" --addr "127.0.0.1:$port" --db-path "$db" \
       --run-id "$run_id" compact-build --new-db "$newdb" --baseline-out "$base"; then
    rm -f "$newdb" "$base"
    _start_stopped_ingestors
    trap - EXIT
    echo -e "${YELLOW}未压缩；库可正常使用，腾出空间后可再执行。${NC}"
    return 1
  fi

  # 换文件。原文件一旦移走，后面每一步失败都要走 _compact_restore 换回来，
  # 所以这里不依赖 set -e：它只会让脚本带着一个不在原位的库文件退出。
  # 旧服务端必须真的退出了才能换：它还占着端口的话，新服务端起不来。
  local why=""
  if ! _stop_server_and_wait "$port"; then
    why="旧服务端没有退出"
  elif ! mv "$db" "$bak"; then
    why="移走原文件失败（mv）"
  fi
  if [[ -n "$why" ]]; then
    echo -e "${RED}换文件没有开始：${why}；库未改动，未压缩${NC}"
    _svc_start "$SVC_SERVER"
    _wait_server "$port" "$ver" || _server_log_tail
    rm -f "$newdb" "$base"
    _start_stopped_ingestors
    trap - EXIT
    return 1
  fi
  if [[ -f "$wal" ]]; then mv "$wal" "$bak.wal"; fi
  rm -f "$newdb.wal"        # DETACH 后不该有；留着会被当成新库的 wal 回放

  if ! mv "$newdb" "$db"; then
    why="新文件放不到原位（mv）"
  elif ! _svc_start "$SVC_SERVER"; then
    why="启动服务端的命令失败"
  elif ! _wait_server "$port" "$ver"; then
    why="服务端 120s 内没有以 v${ver} 在 :${port} 就绪"
  elif ! "$py" "$REPO_DIR/scripts/upgrade.py" --addr "127.0.0.1:$port" --db-path "$db" \
         --run-id "$run_id" compact-check --baseline "$base"; then
    why="换文件后校验未通过（见上）"
  fi
  if [[ -z "$why" ]]; then
    rm -f "$bak" "$bak.wal" "$base"
    _start_stopped_ingestors
    trap - EXIT
    echo -e "  ${GREEN}✓${NC} 已删除换下的原文件"
    return 0
  fi
  echo -e "\n${RED}换文件失败：${why}${NC}"
  _server_log_tail
  _compact_restore "$port" "$db" "$newdb" "$bak" "$wal" "$ver"
  rm -f "$base"
  _start_stopped_ingestors
  trap - EXIT
  return 1
}

# 把换下的原文件换回原位；用于换文件之后任何一步失败。
_compact_restore() {
  local port="$1" db="$2" newdb="$3" bak="$4" wal="$5" ver="$6"
  echo -e "\n${YELLOW}换回原文件${NC}"
  _stop_server_and_wait "$port" || true
  if [[ -f "$db" ]]; then mv "$db" "$newdb"; fi
  rm -f "$wal"              # 这是新库的 wal，留在原文件旁边会被当成它的 wal 回放
  mv "$bak" "$db"
  if [[ -f "$bak.wal" ]]; then mv "$bak.wal" "$wal"; fi
  _svc_start "$SVC_SERVER"
  if _wait_server "$port" "$ver"; then
    echo -e "${RED}已回到压缩前的状态${NC}（没通过校验的新文件留在 ${newdb}）"
  else
    echo -e "${RED}回退后服务端未就绪，需要人工处理${NC}（原文件已换回 ${db}）"
    _server_log_tail
  fi
}

